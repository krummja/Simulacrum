{
    "python.analysis.typeCheckingMode": "off",
    "basedpyright.analysis.exclude": [
        "build",
        "cmake",
        "src",
        "src_old",
        "tests",
        "include",
        "res"
    ],
    "markdown.styles": [
        "docs\\styles.css"
    ],
    "editor.quickSuggestions": {
        "other": "on",
        "comments": "off",
        "strings": "off"
    },
    "editor.quickSuggestionsDelay": 10
}